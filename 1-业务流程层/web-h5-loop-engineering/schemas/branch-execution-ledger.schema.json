{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oh-my-reverse-skill.local/low-loop/v3/branch-execution-ledger.schema.json",
  "title": "Low-LOOP V3 BranchExecutionLedger",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ledger_id", "repository_id", "base_branch", "base_sha", "topic_branch", "worktree_id", "worktree_path", "implementation_status", "capability_level", "current_workflow_status", "events", "topic_commit", "merge", "post_merge", "rollback", "cleanup", "worktree_decision", "branch_decision", "ledger_sha256"],
  "properties": {
    "schema_version": {"const": "3.0.0"}, "ledger_id": {"type": "string", "minLength": 1}, "repository_id": {"type": "string", "minLength": 1}, "base_branch": {"type": "string", "minLength": 1}, "base_sha": {"$ref": "#/$defs/git_sha"}, "topic_branch": {"type": "string", "minLength": 1}, "worktree_id": {"type": "string", "minLength": 1}, "worktree_path": {"type": "string", "minLength": 1},
    "implementation_status": {"const": "MANUAL_ORCHESTRATED_LEDGER_ONLY"}, "capability_level": {"const": "structure_only"}, "current_workflow_status": {"$ref": "#/$defs/workflow_status"},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}},
    "topic_commit": {"$ref": "#/$defs/topic_commit"}, "merge": {"$ref": "#/$defs/merge"}, "post_merge": {"$ref": "#/$defs/post_merge"}, "rollback": {"$ref": "#/$defs/rollback"},
    "cleanup": {"type": "object", "additionalProperties": false, "required": ["decision_ids", "completed"], "properties": {"decision_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "completed": {"type": "boolean"}}},
    "worktree_decision": {"$ref": "#/$defs/resource_decision"}, "branch_decision": {"$ref": "#/$defs/resource_decision"}, "ledger_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "workflow_status": {"enum": ["PLANNED", "AUTHORIZED", "RUNNING", "VERIFYING", "GOVERNING", "BLOCKED", "HUMAN_REVIEW", "READY_TO_COMMIT", "COMMITTED", "READY_TO_MERGE", "MERGED", "POST_MERGE_VERIFYING", "ROLLING_BACK", "ROLLED_BACK", "CLOSING", "CLOSED"]},
    "event": {"type": "object", "additionalProperties": false, "required": ["sequence", "event_id", "actor_id", "actor_role", "from_status", "to_status", "timestamp", "evidence_artifact_ids", "grant_ids", "previous_event_sha256", "event_sha256"], "properties": {"sequence": {"type": "integer", "minimum": 1}, "event_id": {"type": "string", "minLength": 1}, "actor_id": {"type": "string", "minLength": 1}, "actor_role": {"enum": ["AUTHORITY", "PLANNER", "EXECUTOR", "VERIFIER", "GOVERNOR", "HUMAN_REVIEWER"]}, "from_status": {"type": ["string", "null"]}, "to_status": {"$ref": "#/$defs/workflow_status"}, "timestamp": {"type": "string", "format": "date-time"}, "evidence_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "grant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "previous_event_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}, "event_sha256": {"$ref": "#/$defs/sha256"}}},
    "topic_commit": {"type": "object", "additionalProperties": false, "required": ["status", "sha", "parent_sha", "grant_id", "evidence_artifact_ids"], "properties": {"status": {"enum": ["NOT_CREATED", "CREATED"]}, "sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "parent_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "grant_id": {"type": ["string", "null"]}, "evidence_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "merge": {"type": "object", "additionalProperties": false, "required": ["status", "strategy", "pre_merge_base_sha", "topic_sha", "merge_sha", "parent_shas", "grant_id", "evidence_artifact_ids"], "properties": {"status": {"enum": ["NOT_MERGED", "MERGED", "FAILED"]}, "strategy": {"enum": ["NONE", "FAST_FORWARD", "MERGE_COMMIT", "SQUASH", "REBASE"]}, "pre_merge_base_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "topic_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "merge_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "parent_shas": {"type": "array", "items": {"$ref": "#/$defs/git_sha"}, "uniqueItems": true}, "grant_id": {"type": ["string", "null"]}, "evidence_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "post_merge": {"type": "object", "additionalProperties": false, "required": ["required", "run_id", "verification_id", "status", "tested_sha"], "properties": {"required": {"const": true}, "run_id": {"type": ["string", "null"]}, "verification_id": {"type": ["string", "null"]}, "status": {"enum": ["PENDING", "PASS", "FAILED", "INCONCLUSIVE"]}, "tested_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}}},
    "rollback": {"type": "object", "additionalProperties": false, "required": ["status", "target_sha", "rollback_commit_sha", "grant_id", "verification_id", "topology_closed"], "properties": {"status": {"enum": ["NOT_REQUIRED", "PLANNED", "IN_PROGRESS", "COMPLETED", "FAILED"]}, "target_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "rollback_commit_sha": {"type": ["string", "null"], "pattern": "^[a-f0-9]{40,64}$"}, "grant_id": {"type": ["string", "null"]}, "verification_id": {"type": ["string", "null"]}, "topology_closed": {"type": "boolean"}}},
    "resource_decision": {"type": "object", "additionalProperties": false, "required": ["decision", "grant_id", "reason", "evidence_artifact_ids"], "properties": {"decision": {"enum": ["KEEP", "REMOVE", "HUMAN_REVIEW"]}, "grant_id": {"type": ["string", "null"]}, "reason": {"type": "string", "minLength": 1}, "evidence_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}}
  }
}
