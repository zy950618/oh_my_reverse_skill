{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oh-my-reverse-skill.local/low-loop/v3/index.schema.json",
  "title": "Low-LOOP V3 Bundle Index",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "bundle_id", "implementation_status", "capability_level", "references", "current_state", "index_sha256"],
  "properties": {
    "schema_version": {"const": "3.0.0"}, "bundle_id": {"type": "string", "minLength": 1}, "implementation_status": {"const": "MANUAL_ORCHESTRATED_LEDGER_ONLY"}, "capability_level": {"const": "structure_only"},
    "references": {
      "type": "object", "additionalProperties": false,
      "required": ["task_spec", "run_results", "artifact_manifest", "verification_results", "governor_decisions", "authorization_grants", "cleanup_decisions", "branch_execution_ledger"],
      "properties": {
        "task_spec": {"$ref": "#/$defs/object_ref"}, "run_results": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}}, "artifact_manifest": {"$ref": "#/$defs/object_ref"}, "verification_results": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}}, "governor_decisions": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}}, "authorization_grants": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}}, "cleanup_decisions": {"type": "array", "items": {"$ref": "#/$defs/object_ref"}}, "branch_execution_ledger": {"$ref": "#/$defs/object_ref"}
      }
    },
    "current_state": {"type": "object", "additionalProperties": false, "required": ["workflow_status", "latest_event_id", "latest_event_sha256", "ledger_sha256", "updated_at"], "properties": {"workflow_status": {"enum": ["PLANNED", "AUTHORIZED", "RUNNING", "VERIFYING", "GOVERNING", "BLOCKED", "HUMAN_REVIEW", "READY_TO_COMMIT", "COMMITTED", "READY_TO_MERGE", "MERGED", "POST_MERGE_VERIFYING", "ROLLING_BACK", "ROLLED_BACK", "CLOSING", "CLOSED"]}, "latest_event_id": {"type": "string", "minLength": 1}, "latest_event_sha256": {"$ref": "#/$defs/sha256"}, "ledger_sha256": {"$ref": "#/$defs/sha256"}, "updated_at": {"type": "string", "format": "date-time"}}},
    "index_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "object_ref": {"type": "object", "additionalProperties": false, "required": ["object_id", "path", "schema_id", "sha256"], "properties": {"object_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "schema_id": {"enum": ["https://schemas.oh-my-reverse-skill.local/low-loop/v3/task-spec.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/run-result.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/artifact-manifest.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/verification-result.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/governor-decision.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/authorization-grant.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/cleanup-decision.schema.json", "https://schemas.oh-my-reverse-skill.local/low-loop/v3/branch-execution-ledger.schema.json"]}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "task_spec_schema": {"$ref": "task-spec.schema.json"},
    "run_result_schema": {"$ref": "run-result.schema.json"},
    "artifact_manifest_schema": {"$ref": "artifact-manifest.schema.json"},
    "verification_result_schema": {"$ref": "verification-result.schema.json"},
    "governor_decision_schema": {"$ref": "governor-decision.schema.json"},
    "authorization_grant_schema": {"$ref": "authorization-grant.schema.json"},
    "cleanup_decision_schema": {"$ref": "cleanup-decision.schema.json"},
    "branch_execution_ledger_schema": {"$ref": "branch-execution-ledger.schema.json"}
  }
}
