{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oh-my-reverse-skill.local/low-loop/v3/governor-decision.schema.json",
  "title": "Low-LOOP V3 GovernorDecision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "task_id", "governor_actor_id", "governor_run_id", "executor_actor_ids", "scope", "current_capability_level", "capability_ceiling", "decision", "safety", "provenance", "owner", "cleanup", "rollback", "blockers", "evidence_artifact_ids", "allowed_next_transition", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0.0"}, "decision_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1},
    "governor_actor_id": {"type": "string", "minLength": 1}, "governor_run_id": {"type": "string", "minLength": 1}, "executor_actor_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "scope": {"$ref": "#/$defs/scope"}, "current_capability_level": {"$ref": "#/$defs/capability_level"}, "capability_ceiling": {"const": "structure_only"},
    "decision": {"enum": ["ALLOW_TRANSITION", "BLOCK", "HUMAN_REVIEW", "ROLLBACK"]},
    "safety": {"$ref": "#/$defs/gate"}, "provenance": {"$ref": "#/$defs/gate"}, "owner": {"$ref": "#/$defs/gate"}, "cleanup": {"$ref": "#/$defs/gate"}, "rollback": {"$ref": "#/$defs/gate"},
    "blockers": {"type": "array", "items": {"$ref": "#/$defs/blocker"}}, "evidence_artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "allowed_next_transition": {"enum": ["NONE", "PLAN", "START_RUN", "VERIFY", "GOVERN", "TOPIC_COMMIT", "MERGE_LOCAL", "POST_MERGE_VERIFY", "ROLLBACK", "CLEANUP", "CLOSE", "HUMAN_REVIEW"]},
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"decision": {"const": "HUMAN_REVIEW"}}, "required": ["decision"]}, "then": {"properties": {"allowed_next_transition": {"const": "HUMAN_REVIEW"}}}}
  ],
  "$defs": {
    "capability_level": {"enum": ["structure_only", "local_lab_ready", "local_lab_positive", "authorized_observation_ready", "authorized_target_candidate", "positive_allowed"]},
    "scope": {"type": "object", "additionalProperties": false, "required": ["repository_id", "base_sha", "topic", "paths", "capabilities", "distribution"], "properties": {"repository_id": {"type": "string", "minLength": 1}, "base_sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "topic": {"type": "string", "minLength": 1}, "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability_level"}, "uniqueItems": true}, "distribution": {"enum": ["LOCAL_ONLY", "LOCAL_MERGE", "REMOTE"]}}},
    "gate": {"type": "object", "additionalProperties": false, "required": ["status", "reason", "evidence_artifact_ids"], "properties": {"status": {"enum": ["PASS", "FAILED", "INCONCLUSIVE", "NOT_APPLICABLE"]}, "reason": {"type": "string", "minLength": 1}, "evidence_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "blocker": {"type": "object", "additionalProperties": false, "required": ["blocker_id", "reason", "artifact_ids", "paths", "capabilities", "distribution"], "properties": {"blocker_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "paths": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}, "capabilities": {"type": "array", "items": {"$ref": "#/$defs/capability_level"}, "uniqueItems": true}, "distribution": {"enum": ["LOCAL_ONLY", "LOCAL_MERGE", "REMOTE"]}}}
  }
}
