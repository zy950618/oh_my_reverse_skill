{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oh-my-reverse-skill.local/low-loop/v3/verification-result.schema.json",
  "title": "Low-LOOP V3 VerificationResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "verification_id", "task_id", "executor_actor_id", "executor_run_id", "verifier_actor_id", "verifier_run_id", "status", "merge_blocked", "frozen_judges", "checks", "created_at"],
  "properties": {
    "schema_version": {"const": "3.0.0"}, "verification_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1},
    "executor_actor_id": {"type": "string", "minLength": 1}, "executor_run_id": {"type": "string", "minLength": 1}, "verifier_actor_id": {"type": "string", "minLength": 1}, "verifier_run_id": {"type": "string", "minLength": 1},
    "status": {"enum": ["PASS", "FAILED", "INCONCLUSIVE"]}, "merge_blocked": {"type": "boolean"},
    "frozen_judges": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["judge_id", "sha256"], "properties": {"judge_id": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}}}},
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": ["positive", "negative", "adversarial"],
      "properties": {
        "positive": {"$ref": "#/$defs/check_list"},
        "negative": {"$ref": "#/$defs/check_list"},
        "adversarial": {"$ref": "#/$defs/check_list"}
      }
    },
    "created_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {"if": {"properties": {"status": {"const": "INCONCLUSIVE"}}, "required": ["status"]}, "then": {"properties": {"merge_blocked": {"const": true}}}}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "check_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/check"}},
    "check": {
      "type": "object", "additionalProperties": false,
      "required": ["assertion_id", "category", "comparator", "expected", "actual", "artifact_ids", "json_pointers", "judge_id", "judge_sha256", "status"],
      "properties": {
        "assertion_id": {"type": "string", "minLength": 1}, "category": {"enum": ["POSITIVE", "NEGATIVE", "ADVERSARIAL"]},
        "comparator": {"enum": ["EQUALS", "NOT_EQUALS", "CONTAINS", "MATCHES_REGEX", "JSON_SCHEMA", "JSON_POINTER_EQUALS", "HASH_EQUALS", "EXIT_CODE_EQUALS", "SET_EQUALS", "SUBSET"]},
        "expected": {}, "actual": {}, "artifact_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "json_pointers": {"type": "array", "items": {"type": "string", "pattern": "^(|/.*)$"}, "uniqueItems": true},
        "judge_id": {"type": "string", "minLength": 1}, "judge_sha256": {"$ref": "#/$defs/sha256"}, "status": {"enum": ["PASS", "FAILED", "INCONCLUSIVE"]}
      }
    }
  }
}
