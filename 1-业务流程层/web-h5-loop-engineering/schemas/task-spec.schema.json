{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oh-my-reverse-skill.local/low-loop/v3/task-spec.schema.json",
  "title": "Low-LOOP V3 TaskSpec",
  "type": "object",
  "additionalProperties": false,
  "required": ["standard_version", "schema_version", "task_id", "title", "topic", "objective", "non_goals", "base_sha", "dependencies", "context", "roots", "allowed_paths", "forbidden_paths", "commands", "required_outputs", "validations", "frozen_judges", "grant_ids", "budgets", "stop_conditions", "rollback", "implementation_status", "capability_ceiling"],
  "properties": {
    "standard_version": {"const": "3.0.0-candidate"},
    "schema_version": {"const": "3.0.0"},
    "task_id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "non_goals": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "base_sha": {"$ref": "#/$defs/git_sha"},
    "dependencies": {"type": "array", "items": {"$ref": "#/$defs/dependency"}, "uniqueItems": true},
    "context": {
      "type": "object", "additionalProperties": false,
      "required": ["repository_id", "worktree_id", "trust_class", "facts"],
      "properties": {
        "repository_id": {"type": "string", "minLength": 1},
        "worktree_id": {"type": "string", "minLength": 1},
        "trust_class": {"$ref": "#/$defs/trust_class"},
        "facts": {"type": "array", "items": {"$ref": "#/$defs/context_fact"}}
      }
    },
    "roots": {
      "type": "object", "additionalProperties": false,
      "required": ["read_roots", "write_roots", "execute_roots", "output_roots"],
      "properties": {
        "read_roots": {"$ref": "#/$defs/root_list"},
        "write_roots": {"$ref": "#/$defs/root_list"},
        "execute_roots": {"$ref": "#/$defs/root_list"},
        "output_roots": {"$ref": "#/$defs/root_list"}
      }
    },
    "allowed_paths": {"type": "array", "items": {"$ref": "#/$defs/path_rule"}},
    "forbidden_paths": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/path_rule"}},
    "commands": {"type": "array", "items": {"$ref": "#/$defs/command"}},
    "required_outputs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/required_output"}},
    "validations": {
      "type": "object", "additionalProperties": false,
      "required": ["positive", "negative", "adversarial"],
      "properties": {
        "positive": {"$ref": "#/$defs/validation_list"},
        "negative": {"$ref": "#/$defs/validation_list"},
        "adversarial": {"$ref": "#/$defs/validation_list"}
      }
    },
    "frozen_judges": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/frozen_judge"}},
    "grant_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_rounds", "max_attempts", "max_wall_time_seconds", "max_tokens", "max_artifacts"],
      "properties": {
        "max_rounds": {"type": "integer", "minimum": 1}, "max_attempts": {"type": "integer", "minimum": 1},
        "max_wall_time_seconds": {"type": "integer", "minimum": 1}, "max_tokens": {"type": "integer", "minimum": 1},
        "max_artifacts": {"type": "integer", "minimum": 1}
      }
    },
    "stop_conditions": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/stop_condition"}},
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["strategy", "preconditions", "recovery_artifact_ids", "requires_grant_operation"],
      "properties": {
        "strategy": {"type": "string", "minLength": 1},
        "preconditions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "recovery_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "requires_grant_operation": {"const": "rollback_commit"}
      }
    },
    "implementation_status": {"const": "MANUAL_ORCHESTRATED_LEDGER_ONLY"},
    "capability_ceiling": {"const": "structure_only"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_sha": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
    "trust_class": {"enum": ["USER_AUTHORITY", "GOVERNANCE", "TASKSPEC", "REPOSITORY_DATA", "EXTERNAL_DATA", "MODEL_DATA", "SECRET", "QUARANTINED"]},
    "dependency": {"type": "object", "additionalProperties": false, "required": ["dependency_id", "kind", "reference", "required"], "properties": {"dependency_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["TASK", "ARTIFACT", "SCHEMA", "GOVERNANCE", "TOOL"]}, "reference": {"type": "string", "minLength": 1}, "required": {"type": "boolean"}}},
    "context_fact": {"type": "object", "additionalProperties": false, "required": ["fact_id", "statement", "fact_level", "trust_class", "evidence_artifact_ids"], "properties": {"fact_id": {"type": "string", "minLength": 1}, "statement": {"type": "string", "minLength": 1}, "fact_level": {"enum": ["observed", "derived", "assumed", "unverified"]}, "trust_class": {"$ref": "#/$defs/trust_class"}, "evidence_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}}},
    "root_list": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "path_rule": {"type": "object", "additionalProperties": false, "required": ["path", "reason"], "properties": {"path": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "command": {"type": "object", "additionalProperties": false, "required": ["command_id", "program", "argv", "cwd", "purpose"], "properties": {"command_id": {"type": "string", "minLength": 1}, "program": {"type": "string", "minLength": 1}, "argv": {"type": "array", "items": {"type": "string"}}, "cwd": {"type": "string", "minLength": 1}, "purpose": {"type": "string", "minLength": 1}, "timeout_seconds": {"type": "integer", "minimum": 1}}},
    "required_output": {"type": "object", "additionalProperties": false, "required": ["output_id", "path", "media_type", "description"], "properties": {"output_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "description": {"type": "string", "minLength": 1}}},
    "validation_list": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/validation"}},
    "validation": {"type": "object", "additionalProperties": false, "required": ["validation_id", "assertion", "judge_id"], "properties": {"validation_id": {"type": "string", "minLength": 1}, "assertion": {"type": "string", "minLength": 1}, "judge_id": {"type": "string", "minLength": 1}}},
    "frozen_judge": {"type": "object", "additionalProperties": false, "required": ["judge_id", "version", "sha256", "frozen_at"], "properties": {"judge_id": {"type": "string", "minLength": 1}, "version": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha256"}, "frozen_at": {"type": "string", "format": "date-time"}}},
    "stop_condition": {"type": "object", "additionalProperties": false, "required": ["condition_id", "kind", "threshold", "action"], "properties": {"condition_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["REPEATED_BLOCKER", "BUDGET_EXHAUSTED", "AUTHORIZATION_MISSING", "JUDGE_DRIFT", "EVIDENCE_CONFLICT", "SAFETY_BOUNDARY", "MANUAL_REVIEW"]}, "threshold": {"type": "integer", "minimum": 1}, "action": {"enum": ["STOP", "BLOCK", "HUMAN_REVIEW"]}}}
  }
}
