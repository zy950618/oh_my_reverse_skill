{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.oh-my-reverse-skill.local/low-loop/v3/artifact-manifest.schema.json",
  "title": "Low-LOOP V3 ArtifactManifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "manifest_id", "task_id", "created_at", "artifacts"],
  "properties": {
    "schema_version": {"const": "3.0.0"}, "manifest_id": {"type": "string", "minLength": 1}, "task_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_id", "path", "media_type", "size_bytes", "sha256", "producer", "trust_class", "parent_artifact_ids", "lineage", "redaction", "provenance", "owner", "is_unique", "is_reproducible", "retention_class", "retain_until", "hold_flags", "migration", "references"],
      "properties": {
        "artifact_id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1}, "size_bytes": {"type": "integer", "minimum": 0}, "sha256": {"$ref": "#/$defs/sha256"},
        "producer": {"type": "object", "additionalProperties": false, "required": ["actor_id", "invocation_id", "run_id", "command_id"], "properties": {"actor_id": {"type": "string", "minLength": 1}, "invocation_id": {"type": "string", "minLength": 1}, "run_id": {"type": "string", "minLength": 1}, "command_id": {"type": "string", "minLength": 1}}},
        "trust_class": {"enum": ["USER_AUTHORITY", "GOVERNANCE", "TASKSPEC", "REPOSITORY_DATA", "EXTERNAL_DATA", "MODEL_DATA", "SECRET", "QUARANTINED"]},
        "parent_artifact_ids": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
        "lineage": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["input_artifact_id", "input_sha256", "transformation"], "properties": {"input_artifact_id": {"type": "string", "minLength": 1}, "input_sha256": {"$ref": "#/$defs/sha256"}, "transformation": {"type": "string", "minLength": 1}}}},
        "redaction": {"type": "object", "additionalProperties": false, "required": ["status", "method", "verified_by"], "properties": {"status": {"enum": ["NOT_REQUIRED", "PENDING", "REDACTED", "FAILED"]}, "method": {"type": ["string", "null"]}, "verified_by": {"type": ["string", "null"]}}},
        "provenance": {"type": "object", "additionalProperties": false, "required": ["status", "source", "scope", "blockers"], "properties": {"status": {"enum": ["RESOLVED", "PARTIAL", "UNRESOLVED"]}, "source": {"type": "string", "minLength": 1}, "scope": {"type": "string", "minLength": 1}, "blockers": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
        "owner": {"type": "object", "additionalProperties": false, "required": ["status", "owner_id"], "properties": {"status": {"enum": ["KNOWN", "UNKNOWN"]}, "owner_id": {"type": ["string", "null"]}}},
        "is_unique": {"type": "boolean"}, "is_reproducible": {"type": "boolean"},
        "retention_class": {"enum": ["TEMPORARY", "EVIDENCE", "FAILURE_EVIDENCE", "CLOSURE_EVIDENCE", "GOVERNANCE", "SECRET_QUARANTINE"]},
        "retain_until": {"type": ["string", "null"], "format": "date-time"},
        "hold_flags": {"type": "array", "items": {"enum": ["LEGAL", "SECURITY", "HUMAN_REVIEW", "PROVENANCE", "CLOSURE", "OWNER"]}, "uniqueItems": true},
        "migration": {"type": "object", "additionalProperties": false, "required": ["migrated", "destination_artifact_id", "verified"], "properties": {"migrated": {"type": "boolean"}, "destination_artifact_id": {"type": ["string", "null"]}, "verified": {"type": "boolean"}}},
        "references": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["referrer_id", "kind", "json_pointer"], "properties": {"referrer_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["ARTIFACT", "LEDGER_EVENT", "VERIFICATION", "DECISION", "INDEX"]}, "json_pointer": {"type": "string"}}}}
      }
    }
  }
}
